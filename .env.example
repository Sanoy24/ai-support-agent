# Copy this file to .env and adjust it. Every setting has a working default for the local demo.

# --- Store ----------------------------------------------------------------
STORE_NAME="Trailhead Supply Co."
# "mock" uses the bundled demo store. Use "shopify" for a real store.
STORE_BACKEND=mock
# SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# Admin API access token with read_orders and read_products scopes.
# SHOPIFY_ACCESS_TOKEN=
# Folder with your own policy Markdown files (defaults to the demo policies).
# POLICIES_DIR=./policies

# --- Language model -------------------------------------------------------
# Any OpenAI-compatible API. The default is a local Ollama server (free).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=granite4.2:8b
# Only needed for hosted providers such as OpenAI, OpenRouter or Groq.
# LLM_API_KEY=
# "none" turns off step-by-step reasoning on Ollama, which is much faster.
# Remove it for providers that don't support the setting.
LLM_REASONING_EFFORT=none

# --- Embeddings -----------------------------------------------------------
# "ollama" (default), "fastembed" (needs the local-embeddings extra) or "hashing" (offline, lexical).
EMBEDDINGS_BACKEND=ollama
EMBEDDINGS_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# --- App ------------------------------------------------------------------
DATABASE_URL=sqlite:///data/local/support.db
# Set a long random value to enable the admin dashboard at /admin.
# ADMIN_PASSWORD=
# Key for signing admin sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, admins are signed out whenever the server restarts.
# SESSION_SECRET=
# Websites allowed to embed the chat widget, as a JSON list.
# ALLOWED_ORIGINS=["https://your-store.com"]
CHAT_RATE_LIMIT_PER_MINUTE=20
